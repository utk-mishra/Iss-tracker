      "169": {
        "chunkId": "0c085e",
        "hash": "bd8fbb0c",
        "encoded": "###%20GitHub%20Actions:%20%22Username%20and%20password%20required%22",
        "prevChunkIds": []
      },
      "171": {
        "chunkId": "0c085e",
        "hash": "74b141f8",
        "encoded": "**Cause**:%20%60DOCKER_USERNAME%60%20or%20%60DOCKER_PASSWORD%60%20secrets%20are%20not%20set%20or%20are%20empty.",
        "prevChunkIds": []
      },
      "173": {
        "chunkId": "0c085e",
        "hash": "b4d18ffc",
        "encoded": "**Fix**:",
        "prevChunkIds": []
      },
      "174": {
        "chunkId": "0c085e",
        "hash": "042bc9cf",
        "encoded": "1.%20Go%20to%20repository%20Settings%20%E2%86%92%20Secrets%20%E2%86%92%20Actions",
        "prevChunkIds": []
      },
      "175": {
        "chunkId": "0c085e",
        "hash": "1b2873d3",
        "encoded": "2.%20Verify%20all%20three%20secrets%20exist:%20%60DOCKER_REGISTRY%60,%20%60DOCKER_USERNAME%60,%20%60DOCKER_PASSWORD%60",
        "prevChunkIds": []
      },
      "176": {
        "chunkId": "0c085e",
        "hash": "766091f0",
        "encoded": "3.%20If%20missing,%20add%20them%20following%20the%20guide%20above",
        "prevChunkIds": []
      },
      "178": {
        "chunkId": "0c085e",
        "hash": "605db2d5",
        "encoded": "###%20GitHub%20Actions:%20%22Resource%20not%20accessible%20by%20integration%22",
        "prevChunkIds": []
      },
      "180": {
        "chunkId": "0c085e",
        "hash": "eeb8e047",
        "encoded": "**Cause**:%20Missing%20%60security-events:%20write%60%20permission%20for%20SARIF%20upload.",
        "prevChunkIds": []
      },
      "182": {
        "chunkId": "0c085e",
        "hash": "891357e9",
        "encoded": "**Fix**:%20Already%20fixed%20in%20%60.github/workflows/ci.yml%60%20(permissions%20block%20added).",
        "prevChunkIds": []
      },
      "184": {
        "chunkId": "0c085e",
        "hash": "6e21cd02",
        "encoded": "###%20Jenkins:%20%22Credentials%20not%20found%22",
        "prevChunkIds": []
      },
      "186": {
        "chunkId": "0c085e",
        "hash": "55f6da8a",
        "encoded": "**Cause**:%20Jenkins%20can't%20find%20the%20credential%20with%20the%20specified%20ID.",
        "prevChunkIds": []
      },
      "188": {
        "chunkId": "0c085e",
        "hash": "fea85a56",
        "encoded": "**Fix**:",
        "prevChunkIds": []
      },
      "189": {
        "chunkId": "0c085e",
        "hash": "6a157b0d",
        "encoded": "1.%20Go%20to%20Jenkins%20%E2%86%92%20Credentials",
        "prevChunkIds": []
      },
      "190": {
        "chunkId": "0c085e",
        "hash": "6206fe86",
        "encoded": "2.%20Verify%20the%20credential%20exists%20with%20exact%20ID:%20%60docker-registry-credentials%60",
        "prevChunkIds": []
      },
      "191": {
        "chunkId": "0c085e",
        "hash": "198d563b",
        "encoded": "3.%20If%20missing,%20add%20it%20following%20the%20guide%20above",
        "prevChunkIds": []
      },
      "193": {
        "chunkId": "0c085e",
        "hash": "bbdb02ae",
        "encoded": "###%20Jenkins:%20Deployment%20fails%20with%20%22Connection%20refused%22",
        "prevChunkIds": []
      },
      "195": {
        "chunkId": "0c085e",
        "hash": "606ce227",
        "encoded": "**Cause**:%20Deployment%20server%20hostname%20or%20SSH%20key%20is%20incorrect.",
        "prevChunkIds": []
      },
      "197": {
        "chunkId": "0c085e",
        "hash": "d99d3a94",
        "encoded": "**Fix**:",
        "prevChunkIds": []
      },
      "198": {
        "chunkId": "0c085e",
        "hash": "f4d8fc9b",
        "encoded": "1.%20Verify%20%60DEPLOY_HOST_DEV%60%20environment%20variable%20is%20set%20correctly",
        "prevChunkIds": []
      },
      "199": {
        "chunkId": "0c085e",
        "hash": "74588f5a",
        "encoded": "2.%20Verify%20SSH%20credentials%20have%20correct%20private%20key",
        "prevChunkIds": []
      },
      "200": {
        "chunkId": "0c085e",
        "hash": "0cd9ad97",
        "encoded": "3.%20Test%20SSH%20connection%20manually:%20%60ssh%20-i%20/path/to/key%20deploy@dev.example.com%60",
        "prevChunkIds": []
      },
