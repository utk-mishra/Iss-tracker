# ISS Tracker Environment Variables (PROMPT.md section 8)
# Copy this file to .env and fill in your values (never commit .env)

# ===== Server Configuration =====
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===== Upstream API URLs =====
# Open-Notify (ISS position) - plain HTTP, no auth required
OPEN_NOTIFY_URL=http://api.open-notify.org/iss-now.json

# Pollux Labs (pass predictions) - HTTPS, no auth required
POLLUX_URL=https://iss-api.polluxlabs.io/iss-pass
POLLUX_PASS_COUNT=20

# Open-Meteo (cloud cover) - HTTPS, no auth required
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ===== API Keys (currently unused but shown for reference) =====
# None of the three upstream APIs require authentication.
# If they did, the key would be read from this variable and sent as a header.
# It would never be logged and would be redacted in error messages.
UPSTREAM_API_KEY=

# ===== Rate Limiting =====
RATE_LIMIT_PER_MINUTE=120

# ===== CORS and Security =====
# Comma-separated list of allowed origins (empty = same-origin only)
CORS_ALLOWED_ORIGINS=

# Trust X-Forwarded-For header for client IP (only when behind a trusted proxy)
TRUSTED_PROXY=false

# ===== Docker Registry (for CI/CD) =====
# Used by Jenkinsfile and GitHub Actions
DOCKER_REGISTRY=docker.io
DOCKER_REGISTRY_USER=your-username
DOCKER_REGISTRY_PASSWORD=your-password-or-token

# ===== Deployment Credentials (for Jenkins) =====
# Dev environment
DEPLOY_HOST_DEV=dev.example.com
DEPLOY_DEV_USER=deploy
DEPLOY_DEV_KEY=/path/to/ssh/key

# Staging environment
DEPLOY_HOST_STAGING=staging.example.com
DEPLOY_STAGING_USER=deploy
DEPLOY_STAGING_KEY=/path/to/ssh/key

# Production environment
DEPLOY_HOST_PROD=prod.example.com
DEPLOY_PROD_USER=deploy
DEPLOY_PROD_KEY=/path/to/ssh/key

# ===== Jenkins Admin (for JCasC) =====
JENKINS_ADMIN_PASSWORD=changeme

# ===== GitHub Integration =====
GITHUB_USER=your-github-username
GITHUB_TOKEN=your-github-token
